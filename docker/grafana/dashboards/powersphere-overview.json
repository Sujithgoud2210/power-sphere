{
  "__inputs": [],
  "__requires": [],
  "title": "PowerSphere - System Overview",
  "version": 1,
  "uid": "powersphere-overview",
  "schemaVersion": 39,
  "tags": ["powersphere", "production"],
  "timezone": "browser",
  "editable": false,
  "panels": [
    {
      "title": "JVM Memory Usage",
      "type": "gauge",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) / sum(jvm_memory_max_bytes{area=\"heap\"}) * 100",
          "legendFormat": "Heap Usage"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"]
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "thresholds": [
        {
          "value": 80,
          "color": "orange"
        },
        {
          "value": 95,
          "color": "red"
        }
      ]
    },
    {
      "title": "HTTP Requests / Second",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count[1m])",
          "legendFormat": "Requests/s"
        }
      ]
    },
    {
      "title": "Active Database Connections",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "hikaricp_connections_active",
          "legendFormat": "Active Connections"
        }
      ]
    },
    {
      "title": "API Response Time (P95)",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket[5m]))",
          "legendFormat": "P95 Response Time"
        }
      ]
    },
    {
      "title": "CPU Usage",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "system_cpu_usage",
          "legendFormat": "System"
        },
        {
          "expr": "process_cpu_usage",
          "legendFormat": "Process"
        }
      ]
    },
    {
      "title": "JVM Thread States",
      "type": "timeseries",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "targets": [
        {
          "expr": "jvm_threads_live_threads",
          "legendFormat": "Live"
        },
        {
          "expr": "jvm_threads_daemon_threads",
          "legendFormat": "Daemon"
        }
      ]
    },
    {
      "title": "Uptime",
      "type": "stat",
      "datasource": {
        "uid": "prometheus",
        "type": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "targets": [
        {
          "expr": "process_uptime_seconds",
          "legendFormat": "Uptime"
        }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "textMode": "auto"
      }
    }
  ]
}
