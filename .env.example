# =============================================================================
# PowerSphere – Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# ---- Application ----
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# ---- Database (MySQL) ----
DB_URL=jdbc:mysql://mysql:3306/powersphere?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_HOST=mysql
DB_PORT=3306
DB_NAME=powersphere
DB_USERNAME=powersphere
DB_PASSWORD=changeme_secure_password
DB_MAX_POOL_SIZE=20
DB_MIN_IDLE=5

# ---- Redis Cache ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
REDIS_POOL_MAX=16
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=2

# ---- JWT Authentication ----
JWT_SECRET=your-256-bit-secret-key-change-in-production-minimum-256-bits
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ---- Logging ----
LOG_LEVEL_ROOT=WARN
LOG_LEVEL_APP=INFO
LOG_LEVEL_SPRING=WARN

# ---- Tomcat ----
TOMCAT_MAX_THREADS=200
TOMCAT_MIN_SPARE=20

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ---- MailHog (Email) ----
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
